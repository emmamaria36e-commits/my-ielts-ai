# Copy this file to .env, add your local values, and start the server.
# The Node server loads .env automatically. Never commit the real file.

AI_API_KEY=
AI_API_ENDPOINT=https://api.deepseek.com/v1/chat/completions
AI_MODEL=deepseek-chat
AI_PROVIDER=deepseek
PORT=3000
SPEECH_KEY=
SPEECH_REGION=
BETA_INVITE_CODES=
AI_ENABLED=false
SPEECH_ENABLED=false
AI_GENERATE_DAILY_LIMIT=15
SPEECH_DAILY_LIMIT=20
GLOBAL_AI_DAILY_LIMIT=100
GLOBAL_SPEECH_DAILY_LIMIT=150
GLOBAL_AI_CONCURRENCY=3
GLOBAL_SPEECH_CONCURRENCY=3
TRUST_PROXY_HOPS=0

# Closed Beta invariants in this version:
# - Per-invite concurrency is fixed at 1 active AI and 1 active Speech request.
# - Short rate limits are fixed at 20 requests per 60 seconds, separately for AI and Speech.
